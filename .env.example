# All optional. Nothing here is a secret; the app needs no API keys.

# Sent to Overpass / OSRM / Nominatim. Put a contact URL or email in it for your deployment.
APP_USER_AGENT="citywalk-planner/0.1 (+https://github.com/<you>/citywalk-planner)"

# Comma-separated Overpass endpoints, tried in order (one attempt each).
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Any OSRM-compatible server with a pedestrian profile.
# OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
# OSRM_PROFILE=foot

# NOMINATIM_URL=https://nominatim.openstreetmap.org

# 1 = serve bundled fixtures only and skip routing (used by the E2E test).
# CITYWALK_OFFLINE=1
