# all optional

# sent to Overpass, OSRM and Nominatim; put a contact in it
APP_USER_AGENT="citywalk-planner/0.1 (+https://github.com/haoyu1zhang/citywalk-planner)"

# comma-separated, tried in order
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter

# any OSRM server with a foot profile
# OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
# OSRM_PROFILE=foot

# adds Ticketmaster events (free key: https://developer.ticketmaster.com)
# TICKETMASTER_API_KEY=

# NOMINATIM_URL=https://nominatim.openstreetmap.org

# 1 = bundled data only, no routing (used by e2e)
# CITYWALK_OFFLINE=1
